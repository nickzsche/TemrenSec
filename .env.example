# TemrenSec configuration — copy to .env and adjust.
# docker compose reads this file; the systemd units in deploy/systemd/ load it via EnvironmentFile.

# ---- API server (cmd/api) ----
PORT=8080
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# Generate with: openssl rand -hex 32   (required; the API refuses to start without it)
JWT_SECRET=
JWT_EXPIRY=24h

# ---- Datastores ----
# Used by docker-compose.yml for the bundled Postgres container.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://temren:change-me@localhost:5432/temren?sslmode=disable
REDIS_URL=redis://localhost:6379

# ---- WebSocket pub/sub bridge (api + worker) ----
# host:port of Redis. Required for live scan progress in the dashboard when the
# worker runs in a separate process/pod, and for running more than one API replica.
TEMREN_WS_REDIS=localhost:6379
TEMREN_WS_REDIS_CHANNEL=temren:ws:broadcast

# ---- Worker (cmd/worker) ----
WORKER_CONCURRENCY=5
SCAN_TIMEOUT=30

# ---- Email (optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Webhooks (optional) ----
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
WEBHOOK_SECRET=

# ---- AI providers (optional; first set key wins) ----
# Override model names without recompiling — see pkg/ai/{anthropic,openai,ollama}.go
ANTHROPIC_API_KEY=
TEMREN_ANTHROPIC_MODEL=claude-opus-4-7
OPENAI_API_KEY=
TEMREN_OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=
TEMREN_OLLAMA_MODEL=llama3
TEMREN_OLLAMA_URL=http://localhost:11434

# ---- Plan limits (internal/config) ----
FREE_PLAN_TARGETS=1
PRO_PLAN_TARGETS=5
TEAM_PLAN_TARGETS=20
FREE_PLAN_SCANS=5
PRO_PLAN_SCANS=50
TEAM_PLAN_SCANS=200

# ---- Frontend (frontend/) ----
# Server-side rewrite target for /api/* (next.config.js). Inside docker compose this is http://api:8080.
API_URL=http://localhost:8080
# Browser-reachable WebSocket endpoint for live scan updates (build-time, NEXT_PUBLIC_*).
NEXT_PUBLIC_WS_URL=ws://localhost:8080
# Leave unset to call the API through the Next.js rewrite proxy (/api/v1).
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
